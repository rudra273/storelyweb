# Portable frontend container for Cloud Run or another managed HTTPS platform.
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		Cache-Control "no-store"
	}
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@api path /v1 /v1/* /health /health/*
	handle @api {
		reverse_proxy {$STORELY_API_ORIGIN} {
			header_up Host {upstream_hostport}
		}
	}
	@assets path /assets/*
	handle @assets {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
